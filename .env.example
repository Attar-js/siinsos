APP_NAME=SIINSOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000

# Aplikasi gabungan: landing + admin dalam SATU host.
# Samakan kedua nilai ini dengan APP_URL (jangan pakai port terpisah).
APP_DASHBOARD_URL="${APP_URL}"
APP_LANDING_URL="${APP_URL}"

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (satu MySQL untuk seluruh aplikasi) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboardta
DB_USERNAME=root
DB_PASSWORD=

# Opsional: alias koneksi legacy. Kosongkan agar memakai DB_* di atas.
# DASHBOARD_DB_HOST=
# DASHBOARD_DB_PORT=
# DASHBOARD_DB_DATABASE=
# DASHBOARD_DB_USERNAME=
# DASHBOARD_DB_PASSWORD=
# PROJECT_AKHIR_DB_HOST=
# PROJECT_AKHIR_DB_PORT=
# PROJECT_AKHIR_DB_DATABASE=
# PROJECT_AKHIR_DB_USERNAME=
# PROJECT_AKHIR_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
