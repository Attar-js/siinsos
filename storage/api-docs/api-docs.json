{
    "openapi": "3.0.0",
    "info": {
        "title": "SIINSOS API — Nilai Akhir",
        "description": "Dokumentasi API tarik data nilai akhir untuk sistem mitra. Contoh nilai di skema bersifat ilustrasi; data asli diambil dari database setelah request berhasil.\n\nCara uji:\n1. Klik Authorize di kanan atas.\n2. Isi X-API-KEY dengan nilai MITRA_API_KEY pada file .env.\n3. Klik Authorize, lalu Execute.\n\nTanpa API key, server mengembalikan 401.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Server SIINSOS"
        }
    ],
    "paths": {
        "/api/nilai-akhir": {
            "get": {
                "tags": [
                    "Nilai Akhir"
                ],
                "summary": "Tarik data nilai akhir semua mahasiswa",
                "description": "Mengembalikan daftar nilai akhir mahasiswa dalam format JSON.",
                "operationId": "1240514a473c980a03a30bd090b5444c",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Kata kunci pencarian (nama/NIM/kelompok)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "semester",
                        "in": "query",
                        "description": "Filter semester kegiatan (1 atau 2)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "enum": [
                                1,
                                2
                            ]
                        },
                        "example": 1
                    },
                    {
                        "name": "tahun",
                        "in": "query",
                        "description": "Filter tahun kegiatan (4 angka)",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 2026
                    },
                    {
                        "name": "id_prodi_gerbang",
                        "in": "query",
                        "description": "Filter kode program studi simkur",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "11111"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/NilaiAkhirItem"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "API key tidak valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "API key tidak valid atau tidak diberikan."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Terjadi kesalahan server",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Terjadi kesalahan server"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ]
            }
        },
        "/api/nilai-akhir/{nim}": {
            "get": {
                "tags": [
                    "Nilai Akhir"
                ],
                "summary": "Tarik data nilai akhir satu mahasiswa",
                "description": "Mengembalikan nilai akhir satu mahasiswa berdasarkan NIM.",
                "operationId": "dd7b569dbd386527ecb0b2799ab3ac72",
                "parameters": [
                    {
                        "name": "nim",
                        "in": "path",
                        "description": "NIM mahasiswa",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "10221051"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/NilaiAkhirItem"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "API key tidak valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "API key tidak valid atau tidak diberikan."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Data tidak ditemukan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Data nilai untuk NIM tersebut tidak ditemukan"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Terjadi kesalahan server",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Terjadi kesalahan server"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "NilaiAkhirKomponen": {
                "properties": {
                    "proposal_kegiatan": {
                        "type": "number",
                        "format": "float",
                        "example": 98,
                        "nullable": true
                    },
                    "asistensi": {
                        "type": "number",
                        "format": "float",
                        "example": 70,
                        "nullable": true
                    },
                    "peer_review": {
                        "type": "number",
                        "format": "float",
                        "example": 74,
                        "nullable": true
                    },
                    "laporan_akhir": {
                        "type": "number",
                        "format": "float",
                        "example": 98,
                        "nullable": true
                    },
                    "presentasi_akhir": {
                        "type": "number",
                        "format": "float",
                        "example": 78,
                        "nullable": true
                    },
                    "pembimbing_lapangan": {
                        "type": "number",
                        "format": "float",
                        "example": 87,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "StudyProgram": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 10
                    },
                    "department_id": {
                        "type": "integer",
                        "example": 2,
                        "nullable": true
                    },
                    "name": {
                        "properties": {
                            "id": {
                                "type": "string",
                                "example": "Informatika"
                            },
                            "en": {
                                "type": "string",
                                "example": "Informatics"
                            }
                        },
                        "type": "object"
                    },
                    "id_prodi_gerbang": {
                        "description": "Kode program studi simkur",
                        "type": "string",
                        "example": "11111"
                    },
                    "study_program_type_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "NilaiAkhirItem": {
                "required": [
                    "nim",
                    "nama",
                    "study_program_id",
                    "nama_kelompok",
                    "dosen",
                    "sudah_dinilai",
                    "nilai_akhir",
                    "komponen",
                    "study_program"
                ],
                "properties": {
                    "nim": {
                        "type": "string",
                        "example": "10221051"
                    },
                    "nama": {
                        "type": "string",
                        "example": "Nama Mahasiswa"
                    },
                    "study_program_id": {
                        "type": "integer",
                        "example": 10,
                        "nullable": true
                    },
                    "nama_kelompok": {
                        "type": "string",
                        "example": "Kelompok X"
                    },
                    "dosen": {
                        "type": "string",
                        "example": "Dr. Pembimbing"
                    },
                    "semester": {
                        "description": "Semester kegiatan (1 atau 2)",
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "tahun_kegiatan": {
                        "description": "Tahun kegiatan (4 angka)",
                        "type": "integer",
                        "example": 2026,
                        "nullable": true
                    },
                    "sudah_dinilai": {
                        "type": "boolean",
                        "example": true
                    },
                    "nilai_akhir": {
                        "type": "number",
                        "format": "float",
                        "example": 86.4,
                        "nullable": true
                    },
                    "komponen": {
                        "$ref": "#/components/schemas/NilaiAkhirKomponen"
                    },
                    "study_program": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/StudyProgram"
                            }
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "ApiKeyAuth": {
                "type": "apiKey",
                "description": "Masukkan API key mitra untuk endpoint tarik data nilai.",
                "name": "X-API-KEY",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Nilai Akhir",
            "description": "Tarik data nilai akhir mahasiswa (untuk sistem mitra)"
        }
    ]
}